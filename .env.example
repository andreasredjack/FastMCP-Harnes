# LM Studio muss auf dem Windows-Desktop den lokalen Server aktivieren.
# Standardmaessig wird die Windows-Host-IP aus /etc/resolv.conf verwendet.
LM_STUDIO_PORT=1234
LM_STUDIO_MODEL=local-model
# Bei abweichender WSL-Netzwerkkonfiguration explizit setzen:
# LM_STUDIO_HOST=172.20.0.1

MCP_HOST=0.0.0.0
MCP_PORT=8000
